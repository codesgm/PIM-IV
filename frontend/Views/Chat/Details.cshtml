@inject PimWeb.Services.AuthService AuthService
@model PimWeb.Models.ChatDetailViewModel
@{
    ViewData["Title"] = $"Chat com {Model.Chat.UserName}";
    
    // Helper para converter UTC para horário local
    string FormatLocalTime(DateTime utcTime, string format = "dd/MM HH:mm")
    {
        var localTime = TimeZoneInfo.ConvertTimeFromUtc(utcTime, TimeZoneInfo.FindSystemTimeZoneById("E. South America Standard Time"));
        return localTime.ToString(format);
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Chat com @Model.Chat.UserName</h1>
        <p class="text-muted mb-0">
            <span class="badge @(Model.Chat.Status == "Active" ? "bg-success" : "bg-secondary") me-2">
                @(Model.Chat.Status == "Active" ? "Ativo" : "Resolvido")
            </span>
            @Model.Chat.UserContact • @FormatLocalTime(Model.Chat.CreatedAt, "dd/MM/yyyy HH:mm")
        </p>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-1"></i>Voltar
        </a>
        @if (Model.Chat.Status == "Active")
        {
            <form method="post" action="@Url.Action("Resolve", new { id = Model.Chat.Id })" class="d-inline">
                <button type="submit" class="btn btn-success" onclick="return confirm('Tem certeza que deseja resolver este chat?')">
                    <i class="fas fa-check me-1"></i>Resolver
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-1"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-1"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <!-- Área de Mensagens -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-comments me-2"></i>Conversa
                    <span class="badge bg-secondary ms-2">@Model.Messages.Count mensagens</span>
                </h5>
            </div>
            <div class="card-body" style="height: 400px; overflow-y: auto;" id="messages-container">
                @if (Model.Messages.Any())
                {
                    @foreach (var message in Model.Messages)
                    {
                        <div class="d-flex @(message.SenderType == "technician" ? "justify-content-end" : "justify-content-start") mb-3">
                            <div class="message-bubble @(message.SenderType == "technician" ? "technician" : "user")" style="max-width: 70%;">
                                <div class="message-content">
                                    @message.Message
                                </div>
                                <div class="message-info">
                                    <small class="text-muted">
                                        @(message.SenderType == "technician" ? message.SenderName ?? "Técnico" : Model.Chat.UserName)
                                        • @FormatLocalTime(message.CreatedAt)
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-comments fa-2x mb-2"></i>
                        <p>Nenhuma mensagem ainda</p>
                    </div>
                }
            </div>
        </div>

        <!-- Formulário de Resposta -->
        @if (Model.Chat.Status == "Active")
        {
            <div class="card">
                <div class="card-body">
                    <form method="post" action="@Url.Action("SendMessage")" id="message-form">
                        <input type="hidden" name="chatId" value="@Model.Chat.Id" />
                        <div class="mb-3">
                            <label for="message" class="form-label">Sua resposta</label>
                            <textarea name="message" class="form-control" rows="3" 
                                      placeholder="Digite sua resposta..." required></textarea>
                        </div>
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Pressione Ctrl+Enter para enviar rapidamente
                            </small>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i>Enviar Resposta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-1"></i>
                Este chat foi resolvido em @(Model.Chat.ResolvedAt.HasValue ? FormatLocalTime(Model.Chat.ResolvedAt.Value, "dd/MM/yyyy HH:mm") : "").
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Informações do Chat -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>Informações
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Usuário:</strong><br>
                    @Model.Chat.UserName
                </div>
                <div class="mb-3">
                    <strong>Contato:</strong><br>
                    @Model.Chat.UserContact
                </div>
                <div class="mb-3">
                    <strong>Origem:</strong><br>
                    <span class="badge bg-info">@Model.Chat.Source.ToUpper()</span>
                </div>
                <div class="mb-3">
                    <strong>Criado em:</strong><br>
                    @FormatLocalTime(Model.Chat.CreatedAt, "dd/MM/yyyy HH:mm")
                </div>
                <div class="mb-3">
                    <strong>Última atualização:</strong><br>
                    @FormatLocalTime(Model.Chat.UpdatedAt, "dd/MM/yyyy HH:mm")
                </div>
                @if (!string.IsNullOrEmpty(Model.Chat.AssignedTechnicianName))
                {
                    <div class="mb-3">
                        <strong>Técnico responsável:</strong><br>
                        @Model.Chat.AssignedTechnicianName
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let lastMessageId = @(Model.Messages.Any() ? Model.Messages.Max(m => m.Id) : 0);
        
        // Polling para novas mensagens
        setInterval(async function() {
            if (document.visibilityState === 'visible') {
                try {
                    const response = await fetch(`@Url.Action("GetNewMessages")?chatId=@Model.Chat.Id&lastMessageId=${lastMessageId}`);
                    const data = await response.json();
                    
                    if (data.success && data.messages && data.messages.length > 0) {
                        const container = document.getElementById('messages-container');
                        
                        data.messages.forEach(message => {
                            const messageDiv = document.createElement('div');
                            messageDiv.className = `d-flex ${message.senderType === 'technician' ? 'justify-content-end' : 'justify-content-start'} mb-3`;
                            
                            const date = new Date(message.createdAt + 'Z'); // Força interpretação como UTC
                            const timeStr = date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }) + ' ' + 
                                          date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                            
                            messageDiv.innerHTML = `
                                <div class="message-bubble ${message.senderType === 'technician' ? 'technician' : 'user'}" style="max-width: 70%;">
                                    <div class="message-content">${message.message}</div>
                                    <div class="message-info">
                                        <small class="text-muted">
                                            ${message.senderType === 'technician' ? (message.senderName || 'Técnico') : '@Model.Chat.UserName'}
                                            • ${timeStr}
                                        </small>
                                    </div>
                                </div>
                            `;
                            
                            container.appendChild(messageDiv);
                            lastMessageId = Math.max(lastMessageId, message.id);
                        });
                        
                        // Scroll para o final
                        container.scrollTop = container.scrollHeight;
                    }
                } catch (error) {
                    console.error('Erro ao buscar mensagens:', error);
                }
            }
        }, 3000);
        
        // Scroll inicial para o final
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('messages-container');
            container.scrollTop = container.scrollHeight;
        });
        
        // Ctrl+Enter para enviar
        document.getElementById('message-form').addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'Enter') {
                this.submit();
            }
        });
    </script>
    
    <style>
        .message-bubble {
            padding: 12px 16px;
            border-radius: 18px;
            margin-bottom: 4px;
        }
        
        .message-bubble.user {
            background-color: #f1f5f9;
            color: #334155;
        }
        
        .message-bubble.technician {
            background-color: #2563eb;
            color: white;
        }
        
        .message-content {
            margin-bottom: 4px;
            word-wrap: break-word;
        }
        
        .message-info {
            opacity: 0.8;
        }
        
        .technician .message-info {
            text-align: right;
        }
    </style>
}
