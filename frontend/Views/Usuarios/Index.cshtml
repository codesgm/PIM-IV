@model PimWeb.Models.UsuarioListViewModel
@inject PimWeb.Services.AuthService AuthService
@{
    ViewData["Title"] = "Gerenciar Usuários";
    var isAdmin = AuthService.IsAdmin();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Gerenciar Usuários</h1>
        <p class="text-muted mb-0">Cadastrar, editar e gerenciar usuários do sistema</p>
    </div>
    @if (isAdmin)
    {
        <a href="@Url.Action("Criar")" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Novo Usuário
        </a>
    }
    else
    {
        <span class="badge bg-info fs-6 px-3 py-2">
            <i class="fas fa-eye me-1"></i>Visualização apenas
        </span>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Perfil</th>
                        <th>Status</th>
                        @if (isAdmin)
                        {
                            <th class="pe-4">Ações</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Usuarios != null && Model.Usuarios.Any())
                    {
                        @foreach (var usuario in Model.Usuarios)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-medium">#@usuario.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium">@usuario.Nome</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@usuario.Email</span>
                                </td>
                                <td>
                                    <span class="badge @(usuario.PerfilAcesso == PimWeb.Models.PerfilAcesso.Administrador ? "bg-primary" : "bg-secondary")">
                                        @usuario.PerfilAcesso
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(usuario.Status == PimWeb.Models.StatusUsuario.Ativo ? "bg-success" : "bg-danger")">
                                        @usuario.Status
                                    </span>
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="pe-4">
                                        <div class="d-flex gap-2">
                                            <a href="@Url.Action("Editar", new { id = usuario.Id })" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit me-1"></i>Editar
                                            </a>
                                            <form method="post" action="@Url.Action("Excluir", new { id = usuario.Id })" class="d-inline" 
                                                  onsubmit="return confirm('Tem certeza que deseja excluir este usuário?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash me-1"></i>Excluir
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? "6" : "5")" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-users fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Nenhum usuário encontrado</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
