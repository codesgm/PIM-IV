@model PimWeb.Models.UsuarioListViewModel
@inject PimWeb.Services.AuthService AuthService
@{
    ViewData["Title"] = "Gerenciar Usuários";
    var isAdmin = AuthService.IsAdmin();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Gerenciar Usuários</h2>
                @if (isAdmin)
                {
                    <a href="@Url.Action("Criar")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Novo Usuário
                    </a>
                }
                else
                {
                    <span class="badge bg-info">Visualização apenas</span>
                }
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Email</th>
                                    <th>Perfil</th>
                                    <th>Status</th>
                                    @if (isAdmin)
                                    {
                                        <th>Ações</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Usuarios != null && Model.Usuarios.Any())
                                {
                                    @foreach (var usuario in Model.Usuarios)
                                    {
                                        <tr>
                                            <td>@usuario.Id</td>
                                            <td>@usuario.Nome</td>
                                            <td>@usuario.Email</td>
                                            <td>
                                                <span class="badge bg-@(usuario.PerfilAcesso == PimWeb.Models.PerfilAcesso.Administrador ? "primary" : "secondary")">
                                                    @usuario.PerfilAcesso
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(usuario.Status == PimWeb.Models.StatusUsuario.Ativo ? "success" : "danger")">
                                                    @usuario.Status
                                                </span>
                                            </td>
                                            @if (isAdmin)
                                            {
                                                <td>
                                                    <a href="@Url.Action("Editar", new { id = usuario.Id })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </a>
                                                    <form method="post" action="@Url.Action("Excluir", new { id = usuario.Id })" class="d-inline" 
                                                          onsubmit="return confirm('Tem certeza que deseja excluir este usuário?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fas fa-trash"></i> Excluir
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@(isAdmin ? "6" : "5")" class="text-center">Nenhum usuário encontrado</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
