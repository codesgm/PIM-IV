                    "Text": "@inject PimWeb.Services.AuthService AuthService\n@model PimWeb.Models.ChatDetailViewModel\n@{\n    ViewData[\"Title\"] = $\"Chat com {Model.Chat.UserName}\";\n}\n\n<div class=\"d-flex justify-content-between align-items-center mb-4\">\n    <div>\n        <h1 class=\"h2 mb-1\">Chat com @Model.Chat.UserName</h1>\n        <p class=\"text-muted mb-0\">\n            <span class=\"badge @(Model.Chat.Status == \"Active\" ? \"bg-success\" : \"bg-secondary\") me-2\">\n                @(Model.Chat.Status == \"Active\" ? \"Ativo\" : \"Resolvido\")\n            </span>\n            @Model.Chat.UserContact • @Model.Chat.CreatedAt.ToString(\"dd/MM/yyyy HH:mm\")\n        </p>\n    </div>\n    <div>\n        <a href=\"@Url.Action(\"Index\")\" class=\"btn btn-outline-secondary me-2\">\n            <i class=\"fas fa-arrow-left me-1\"></i>Voltar\n        </a>\n        @if (Model.Chat.Status == \"Active\")\n        {\n            <form method=\"post\" action=\"@Url.Action(\"Resolve\", new { id = Model.Chat.Id })\" class=\"d-inline\">\n                <button type=\"submit\" class=\"btn btn-success\" onclick=\"return confirm('Tem certeza que deseja resolver este chat?')\">\n                    <i class=\"fas fa-check me-1\"></i>Resolver\n                </button>\n            </form>\n        }\n    </div>\n</div>\n\n@if (TempData[\"SuccessMessage\"] != null)\n{\n    <div class=\"alert alert-success alert-dismissible fade show\">\n        <i class=\"fas fa-check-circle me-1\"></i>\n        @TempData[\"SuccessMessage\"]\n        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\"></button>\n    </div>\n}\n\n@if (TempData[\"ErrorMessage\"] != null)\n{\n    <div class=\"alert alert-danger alert-dismissible fade show\">\n        <i class=\"fas fa-exclamation-triangle me-1\"></i>\n        @TempData[\"ErrorMessage\"]\n        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\"></button>\n    </div>\n}\n\n<div class=\"row\">\n    <div class=\"col-lg-8\">\n        <!-- Área de Mensagens -->\n        <div class=\"card mb-4\">\n            <div class=\"card-header\">\n                <h5 class=\"mb-0\">\n                    <i class=\"fas fa-comments me-2\"></i>Conversa\n                    <span class=\"badge bg-secondary ms-2\">@Model.Messages.Count mensagens</span>\n                </h5>\n            </div>\n            <div class=\"card-body\" style=\"height: 400px; overflow-y: auto;\" id=\"messages-container\">\n                @if (Model.Messages.Any())\n                {\n                    @foreach (var message in Model.Messages)\n                    {\n                        <div class=\"d-flex @(message.SenderType == \"technician\" ? \"justify-content-end\" : \"justify-content-start\") mb-3\">\n                            <div class=\"message-bubble @(message.SenderType == \"technician\" ? \"technician\" : \"user\")\" style=\"max-width: 70%;\">\n                                <div class=\"message-content\">\n                                    @message.Message\n                                </div>\n                                <div class=\"message-info\">\n                                    <small class=\"text-muted\">\n                                        @(message.SenderType == \"technician\" ? message.SenderName ?? \"Técnico\" : Model.Chat.UserName)\n                                        • @message.CreatedAt.ToString(\"dd/MM HH:mm\")\n                                    </small>\n                                </div>\n                            </div>\n                        </div>\n                    }\n                }\n                else\n                {\n                    <div class=\"text-center text-muted py-4\">\n                        <i class=\"fas fa-comments fa-2x mb-2\"></i>\n                        <p>Nenhuma mensagem ainda</p>\n                    </div>\n                }\n            </div>\n        </div>\n\n        <!-- Formulário de Resposta -->\n        @if (Model.Chat.Status == \"Active\")\n        {\n            <div class=\"card\">\n                <div class=\"card-body\">\n                    <form method=\"post\" action=\"@Url.Action(\"SendMessage\")\" id=\"message-form\">\n                        <input type=\"hidden\" name=\"chatId\" value=\"@Model.Chat.Id\" />\n                        <div class=\"mb-3\">\n                            <label for=\"message\" class=\"form-label\">Sua resposta</label>\n                            <textarea name=\"message\" class=\"form-control\" rows=\"3\" \n                                      placeholder=\"Digite sua resposta...\" required></textarea>\n                        </div>\n                        <div class=\"d-flex justify-content-between\">\n                            <small class=\"text-muted\">\n                                <i class=\"fas fa-info-circle me-1\"></i>\n                                Pressione Ctrl+Enter para enviar rapidamente\n                            </small>\n                            <button type=\"submit\" class=\"btn btn-primary\">\n                                <i class=\"fas fa-paper-plane me-1\"></i>Enviar Resposta\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        }\n        else\n        {\n            <div class=\"alert alert-info\">\n                <i class=\"fas fa-info-circle me-1\"></i>\n                Este chat foi resolvido em @Model.Chat.ResolvedAt?.ToString(\"dd/MM/yyyy HH:mm\").\n            </div>\n        }\n    </div>\n\n    <div class=\"col-lg-4\">\n        <!-- Informações do Chat -->\n        <div class=\"card\">\n            <div class=\"card-header\">\n                <h5 class=\"mb-0\">\n                    <i class=\"fas fa-info-circle me-2\"></i>Informações\n                </h5>\n            </div>\n            <div class=\"card-body\">\n                <div class=\"mb-3\">\n                    <strong>Usuário:</strong><br>\n                    @Model.Chat.UserName\n                </div>\n                <div class=\"mb-3\">\n                    <strong>Contato:</strong><br>\n                    @Model.Chat.UserContact\n                </div>\n                <div class=\"mb-3\">\n                    <strong>Origem:</strong><br>\n                    <span class=\"badge bg-info\">@Model.Chat.Source.ToUpper()</span>\n                </div>\n                <div class=\"mb-3\">\n                    <strong>Criado em:</strong><br>\n                    @Model.Chat.CreatedAt.ToString(\"dd/MM/yyyy HH:mm\")\n                </div>\n                <div class=\"mb-3\">\n                    <strong>Última atualização:</strong><br>\n                    @Model.Chat.UpdatedAt.ToString(\"dd/MM/yyyy HH:mm\")\n                </div>\n                @if (!string.IsNullOrEmpty(Model.Chat.AssignedTechnicianName))\n                {\n                    <div class=\"mb-3\">\n                        <strong>Técnico responsável:</strong><br>\n                        @Model.Chat.AssignedTechnicianName\n                    </div>\n                }\n            </div>\n        </div>\n    </div>\n</div>\n\n@section Scripts {\n    <script>\n        let lastMessageId = @(Model.Messages.Any() ? Model.Messages.Max(m => m.Id) : 0);\n        \n        // Polling para novas mensagens\n        setInterval(async function() {\n            if (document.visibilityState === 'visible') {\n                try {\n                    const response = await fetch(`@Url.Action(\"GetNewMessages\")?chatId=@Model.Chat.Id&lastMessageId=${lastMessageId}`);\n                    const data = await response.json();\n                    \n                    if (data.success && data.messages && data.messages.length > 0) {\n                        const container = document.getElementById('messages-container');\n                        \n                        data.messages.forEach(message => {\n                            const messageDiv = document.createElement('div');\n                            messageDiv.className = `d-flex ${message.senderType === 'technician' ? 'justify-content-end' : 'justify-content-start'} mb-3`;\n                            \n                            const date = new Date(message.createdAt);\n                            const timeStr = date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }) + ' ' + \n                                          date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\n                            \n                            messageDiv.innerHTML = `\n                                <div class=\"message-bubble ${message.senderType === 'technician' ? 'technician' : 'user'}\" style=\"max-width: 70%;\">\n                                    <div class=\"message-content\">${message.message}</div>\n                                    <div class=\"message-info\">\n                                        <small class=\"text-muted\">\n                                            ${message.senderType === 'technician' ? (message.senderName || 'Técnico') : '@Model.Chat.UserName'}\n                                            • ${timeStr}\n                                        </small>\n                                    </div>\n                                </div>\n                            `;\n                            \n                            container.appendChild(messageDiv);\n                            lastMessageId = Math.max(lastMessageId, message.id);\n                        });\n                        \n                        // Scroll para o final\n                        container.scrollTop = container.scrollHeight;\n                    }\n                } catch (error) {\n                    console.error('Erro ao buscar mensagens:', error);\n                }\n            }\n        }, 3000);\n        \n        // Scroll inicial para o final\n        document.addEventListener('DOMContentLoaded', function() {\n            const container = document.getElementById('messages-container');\n            container.scrollTop = container.scrollHeight;\n        });\n        \n        // Ctrl+Enter para enviar\n        document.getElementById('message-form').addEventListener('keydown', function(e) {\n            if (e.ctrlKey && e.key === 'Enter') {\n                this.submit();\n            }\n        });\n    </script>\n    \n    <style>\n        .message-bubble {\n            padding: 12px 16px;\n            border-radius: 18px;\n            margin-bottom: 4px;\n        }\n        \n        .message-bubble.user {\n            background-color: #f1f5f9;\n            color: #334155;\n        }\n        \n        .message-bubble.technician {\n            background-color: #2563eb;\n            color: white;\n        }\n        \n        .message-content {\n            margin-bottom: 4px;\n            word-wrap: break-word;\n        }\n        \n        .message-info {\n            opacity: 0.8;\n        }\n        \n        .technician .message-info {\n            text-align: right;\n        }\n    </style>\n}"
